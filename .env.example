# Database (TiDB Cloud)
DATABASE_URL=mysql://user:password@host:4000/database?sslaccept=strict

# Auth
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=1h

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxx
ADMIN_EMAIL=admin@example.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=3000000000

# Factus (Facturación electrónica) - Fase 1
# Credenciales: SOLO en .env, nunca en BD ni en código ni en NEXT_PUBLIC_*
# OAuth password grant (documentación oficial): username = email de la cuenta Factus, password = clave de la cuenta
FACTUS_BASE_URL=
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
FACTUS_NUMBERING_RANGE_ID=
FACTUS_SEND_EMAIL=true